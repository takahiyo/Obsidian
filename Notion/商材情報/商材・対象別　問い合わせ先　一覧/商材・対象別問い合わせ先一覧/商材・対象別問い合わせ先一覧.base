# 商材・対象別問い合わせ先一覧

filters:
  and:
    - note["base"] == link("商材・対象別問い合わせ先一覧.base")
formulas:
  R_備考: note["問い合わせ先"].map(value.asFile().properties["備考"])
  R_限定: note["問い合わせ先"].map(value.asFile().properties["限定"])
  R_連絡先: note["問い合わせ先"].map(value.asFile().properties["連絡先"])
  R_メール: note["問い合わせ先"].map(value.asFile().properties["メール"])
properties:
  file.name:
    displayName: 商材・対象
  ファイル&メディア:
    displayName: ファイル&メディア
  問い合わせ先:
    displayName: 問い合わせ先
  URL:
    displayName: URL
views:
  - type: table
    name: Table View
    order:
      - file.name
      - ファイル&メディア
      - 問い合わせ先
      - URL
      - formula.R_備考
      - formula.R_限定
      - formula.R_連絡先
      - formula.R_メール
