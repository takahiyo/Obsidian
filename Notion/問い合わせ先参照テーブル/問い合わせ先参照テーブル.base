filters:
  and:
    - note["base"] == link("問い合わせ先参照テーブル.base")
properties:
  file.name:
    displayName: 名前
  備考:
    displayName: 備考
  限定:
    displayName: 限定
  ファイル&メディア:
    displayName: ファイル&メディア
  メール:
    displayName: メール
  連絡先:
    displayName: 連絡先
  Wantedly People:
    displayName: Wantedly People
views:
