# 対応履歴

filters:
  and:
    - file.inFolder("Notion/顧客情報/顧客管理/JPビルマネジメント株式会社　名古屋営業所/対応履歴")
    - file.ext == "md"
properties:
  file.name:
    displayName: 要約
  内容:
    displayName: 内容
  日付:
    displayName: 日付
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 内容
      - 日付
