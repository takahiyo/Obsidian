# 対応履歴

filters:
  and:
    - file.inFolder("Notion/顧客情報/顧客管理/一般社団法人愛知県精神科病院協会/対応履歴")
    - file.ext == "md"
properties:
  file.name:
    displayName: 要約
  日付:
    displayName: 日付
  内容:
    displayName: 内容
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 日付
      - 内容
