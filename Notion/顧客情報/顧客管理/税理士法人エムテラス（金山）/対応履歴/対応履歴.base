filters:
  and:
    - file.inFolder("Notion/顧客情報/顧客管理/税理士法人エムテラス（金山）/対応履歴")
    - file.ext == "md"
properties:
  file.name:
    displayName: 要約
  内容:
    displayName: 内容
  日付:
    displayName: 日付
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 内容
      - 日付
    sort:
      - property: 日付
        direction: DESC
