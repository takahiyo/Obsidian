# 対応履歴

filters:
  and:
    - file.inFolder("Notion/顧客情報/顧客管理/長田広告株式会社　LED工場/対応履歴")
    - file.ext == "md"
properties:
  file.name:
    displayName: 要約
  内容:
    displayName: 内容
  ファイル&メディア:
    displayName: ファイル&メディア
  日付:
    displayName: 日付
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 内容
      - ファイル&メディア
      - 日付
