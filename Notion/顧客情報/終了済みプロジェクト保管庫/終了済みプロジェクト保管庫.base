# 終了済みプロジェクト保管庫

filters:
  and:
    - note["base"] == link("終了済みプロジェクト保管庫.base")
properties:
  file.name:
    displayName: プロジェクト名
  親プロジェクト:
    displayName: 親プロジェクト
  サブアイテム:
    displayName: サブアイテム
  親アイテム:
    displayName: 親アイテム
  ファイル&メディア:
    displayName: ファイル&メディア
  サブプロジェクト:
    displayName: サブプロジェクト
  URL:
    displayName: URL
  オーナー:
    displayName: オーナー
  営業段階:
    displayName: 営業段階
  タグ:
    displayName: タグ
  ステータス:
    displayName: ステータス
  期限:
    displayName: 期限
  補足:
    displayName: 補足
  担当者:
    displayName: 担当者
  日付:
    displayName: 日付
  次のプロジェクトを保留中：:
    displayName: 次のプロジェクトを保留中：
  次のプロジェクトにより保留中：:
    displayName: 次のプロジェクトにより保留中：
views:
  - type: table
    name: Table View
    order:
      - file.name
      - 親プロジェクト
      - サブアイテム
      - 親アイテム
      - ファイル&メディア
      - サブプロジェクト
      - URL
      - オーナー
      - 営業段階
      - タグ
      - ステータス
      - 期限
      - 補足
      - 担当者
      - 日付
      - 次のプロジェクトを保留中：
      - 次のプロジェクトにより保留中：
