# フラテイト

filters:
  and:
    - note["base"] == link("フラテイト.base")
properties:
  file.name:
    displayName: 名前
  タグ:
    displayName: タグ
  作成日時:
    displayName: 作成日時
  更新されました:
    displayName: 更新されました
views:
  - type: table
    name: Table View
    order:
      - file.name
      - タグ
      - 作成日時
      - 更新されました
