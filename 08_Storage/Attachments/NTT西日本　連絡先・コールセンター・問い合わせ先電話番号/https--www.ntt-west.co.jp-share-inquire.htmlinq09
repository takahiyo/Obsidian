<script>
!function($) {
	$('.js-modal').modaal({
		close_aria_label: '閉じる（エスケープキーで閉じます）',
		before_open: function() {
			$('html').addClass('modaal-noscroll');
		},
		after_close: function() {
			$('html').removeClass('modaal-noscroll');
		}
	});
}($jq183);

const btnNav = document.querySelector('.js-btn-nav');
const fixedBnr = document.querySelector('.fixed-bnr');

const observer = new IntersectionObserver(([entry]) => {
	fixedBnr.hidden = entry.isIntersecting;
});

observer.observe(btnNav);
</script>
