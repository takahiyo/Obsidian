        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-5" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/jpeg,;clipPath=inset(18.44% 22.44% 18.44% 22%);fontStyle=0;fontSize=10;fontFamily=consolas;" parent="taJ2-aKvOxlszer66Cwq-2" vertex="1">
