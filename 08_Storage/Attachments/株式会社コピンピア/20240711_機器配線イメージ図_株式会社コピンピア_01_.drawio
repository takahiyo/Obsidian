        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-84" value="【Webページ誘導機能】&#xa;お店のWi-Fiをご利用になったお客様には、&#xa;最初だけ指定したWebページを表示させることもできます&#xa;お店からのお知らせをより効果的に案内するお手伝いが可能です" style="text;align=left;verticalAlign=top;rounded=1;fontFamily=consolas;fontSize=10;absoluteArcSize=0;autosize=1;container=0;collapsible=0;resizeWidth=0;resizeHeight=0;spacing=1;sketch=1;fillColor=#dae8fc;glass=0;opacity=70;strokeColor=#6c8ebf;arcSize=10;labelBackgroundColor=none;comic=0;html=0;disableMultiStroke=1;hachureGap=-1;fillWeight=-1;" parent="taJ2-aKvOxlszer66Cwq-10" vertex="1">
