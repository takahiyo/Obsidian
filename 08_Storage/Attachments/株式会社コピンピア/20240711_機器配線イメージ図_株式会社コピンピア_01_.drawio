          <mxGeometry x="594.78" y="40" width="345.22" height="60" as="geometry" />
        </mxCell>
        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-11" value="" style="aspect=fixed;html=1;points=[];align=center;image;fontSize=10;image=img/lib/azure2/networking/Virtual_Network_Gateways.svg;sketch=1;strokeColor=default;strokeWidth=0;fillColor=#99FFCC;gradientColor=#ffffff;fontStyle=0;container=0;fontFamily=consolas;" parent="taJ2-aKvOxlszer66Cwq-6" vertex="1">
