        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-23" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://www.ntt-west.co.jp/smb/topics/security_omakase/img/service_l.gif;fontStyle=0;fontSize=10;fontFamily=consolas;" parent="taJ2-aKvOxlszer66Cwq-9" vertex="1">
