        <mxCell id="719NY9aBTZvdNP2mo6TJ-3" value="・アカウント管理で必要なファイルを必要な人へ&#xa;・1週間前まで巻き戻せる随時バックアップ&#xa;・Windows内蔵のハードディスクの様に使える簡単操作&#xa;・リンク共有機能で社外ともセキュアにファイル共有&#xa;・国内に分散したサーバーで大事なデータを保管" style="text;align=left;verticalAlign=top;rounded=1;fontFamily=consolas;fontSize=10;absoluteArcSize=0;autosize=1;container=0;collapsible=0;resizeWidth=0;resizeHeight=0;spacing=1;sketch=1;fillColor=#cce5ff;glass=0;opacity=70;strokeColor=#FF3333;arcSize=10;labelBackgroundColor=none;comic=0;fontColor=#000000;html=0;disableMultiStroke=1;hachureGap=-1;fillWeight=-1;fontStyle=0" parent="719NY9aBTZvdNP2mo6TJ-4" vertex="1">
