        </mxCell>
        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-13" value="【インターネットの他、社内ネットワークも保護！】&#xa;８つのLANポートは全て個別にセキュリティ監視されています&#xa;万が一、感染や不正通信等の問題が発生した場合でも、&#xa;影響をLANポート単位で最低限に抑えられます" style="text;align=left;verticalAlign=top;rounded=1;fontFamily=consolas;fontSize=10;absoluteArcSize=0;autosize=1;container=0;collapsible=0;resizeWidth=0;resizeHeight=0;spacing=1;sketch=1;fillColor=#cce5ff;glass=0;opacity=70;strokeColor=#FF3333;arcSize=10;labelBackgroundColor=none;comic=0;fontColor=#000000;html=0;disableMultiStroke=1;hachureGap=-1;fillWeight=-1;fontStyle=0" parent="taJ2-aKvOxlszer66Cwq-6" vertex="1">
