        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-80" value="お仕事用のWi-Fiと、お客様やスタッフ用のWi-Fiを独立させて提供可能&#xa;お客様満足度や福利厚生の向上に貢献できます&#xa;" style="text;align=left;verticalAlign=top;rounded=1;fontFamily=consolas;fontSize=10;absoluteArcSize=0;autosize=1;container=0;collapsible=0;resizeWidth=0;resizeHeight=0;spacing=1;sketch=1;fillColor=#dae8fc;glass=0;opacity=70;strokeColor=#6c8ebf;arcSize=10;labelBackgroundColor=none;comic=0;html=0;disableMultiStroke=1;hachureGap=-1;fillWeight=-1;" parent="1" vertex="1">
