        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-6" value="おまかせ&#xa;クラウド&#xa;ストレージ" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://www.ntt-west.co.jp/smb/plan/omakase_storage/img/title_logo_cloudstorage.png;fontStyle=0;fontSize=10;fontFamily=consolas;" parent="PJgY0Ns9T8Uo2BxyzCod-76" vertex="1">
