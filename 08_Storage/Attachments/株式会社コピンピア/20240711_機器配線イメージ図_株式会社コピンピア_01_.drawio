        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-81" value="1台のアクセスポイントで、50～120台のWi-Fi接続に対応できる為、&#xa;沢山のお客様に対応可能です" style="text;align=left;verticalAlign=top;rounded=1;fontFamily=consolas;fontSize=10;absoluteArcSize=0;autosize=1;container=0;collapsible=0;resizeWidth=0;resizeHeight=0;spacing=1;sketch=1;fillColor=#dae8fc;glass=0;opacity=70;strokeColor=#6c8ebf;arcSize=10;labelBackgroundColor=none;comic=0;html=0;disableMultiStroke=1;hachureGap=-1;fillWeight=-1;" parent="1" vertex="1">
