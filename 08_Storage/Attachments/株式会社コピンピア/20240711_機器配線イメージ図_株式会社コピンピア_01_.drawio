        <mxCell id="719NY9aBTZvdNP2mo6TJ-12" value="NTTによる遠隔監視を標準装備&#xa;以上を検知すると、サポートセンターから電話などでお知らせ&#xa;設定変更もリモートで簡単" style="text;align=left;verticalAlign=top;rounded=1;fontFamily=consolas;fontSize=10;absoluteArcSize=0;autosize=1;container=0;collapsible=0;resizeWidth=0;resizeHeight=0;spacing=1;sketch=1;fillColor=#cce5ff;glass=0;opacity=70;strokeColor=#FF3333;arcSize=10;labelBackgroundColor=none;comic=0;fontColor=#000000;html=0;disableMultiStroke=1;hachureGap=-1;fillWeight=-1;fontStyle=0" parent="719NY9aBTZvdNP2mo6TJ-23" vertex="1">
