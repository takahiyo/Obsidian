        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-82" value="【Facebook連携】&#xa;Facebookのチェックイン機能と連動できます&#xa;お客様用Wi-Fiをチェックイン機能で提供可能&#xa;特別に手を煩わせることなく、Facebookを通じた口コミ効果が狙えます" style="text;align=left;verticalAlign=top;rounded=1;fontFamily=consolas;fontSize=10;absoluteArcSize=0;autosize=1;container=0;collapsible=0;resizeWidth=0;resizeHeight=0;spacing=1;sketch=1;fillColor=#dae8fc;glass=0;opacity=70;strokeColor=#6c8ebf;arcSize=10;labelBackgroundColor=none;comic=0;html=0;disableMultiStroke=1;hachureGap=-1;fillWeight=-1;" parent="taJ2-aKvOxlszer66Cwq-11" vertex="1">
