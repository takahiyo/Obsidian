        <mxCell id="zQKqe_HkEYrSprvMVW5D-4" value="出張修理オプション有り&lt;br&gt;　故障・派遣受付：24時間" style="rounded=0;whiteSpace=wrap;html=1;align=left;fontFamily=consolas;" vertex="1" parent="zQKqe_HkEYrSprvMVW5D-2">
          <mxGeometry x="40" width="320" height="50" as="geometry" />
