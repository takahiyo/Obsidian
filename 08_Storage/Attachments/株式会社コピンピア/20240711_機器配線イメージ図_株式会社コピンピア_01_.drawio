        </mxCell>
        <mxCell id="taJ2-aKvOxlszer66Cwq-4" value="" style="group;fontFamily=consolas;" parent="1" connectable="0" vertex="1">
          <mxGeometry x="70" y="250" width="428.47" height="60" as="geometry" />
        </mxCell>
        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-16" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;fontStyle=0;fontSize=10;fontFamily=consolas;" parent="taJ2-aKvOxlszer66Cwq-4" vertex="1">
          <mxGeometry width="58.47" height="58.78" as="geometry" />
        </mxCell>
        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-17" value="【サイバーセキュリティ保険完備！】&#xa;NTT西日本が販売するセキュリティおまかせプランでは、&#xa;お客様の万が一の事故に備えてサイバーセキュリティ保険が付帯されています&#xa;損害賠償、費用損害それぞれ50万円、最大100万円までが補償されます！" style="text;align=left;verticalAlign=top;rounded=1;fontFamily=consolas;fontSize=10;absoluteArcSize=0;autosize=1;container=0;collapsible=0;resizeWidth=0;resizeHeight=0;spacing=1;sketch=1;fillColor=#cce5ff;glass=0;opacity=70;strokeColor=#FF3333;arcSize=10;labelBackgroundColor=none;comic=0;fontColor=#000000;html=0;disableMultiStroke=1;hachureGap=-1;fillWeight=-1;fontStyle=0" parent="taJ2-aKvOxlszer66Cwq-4" vertex="1">
          <mxGeometry x="58.47000000000001" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="taJ2-aKvOxlszer66Cwq-5" value="" style="group;fontFamily=consolas;" parent="1" connectable="0" vertex="1">
          <mxGeometry x="20" y="180" width="473.94" height="60" as="geometry" />
        </mxCell>
        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-20" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;fontStyle=0;fontSize=10;fontFamily=consolas;" parent="taJ2-aKvOxlszer66Cwq-5" vertex="1">
          <mxGeometry width="103.94" height="58.17" as="geometry" />
        </mxCell>
        <mxCell id="PJgY0Ns9T8Uo2BxyzCod-21" value="【月次レポートで社内ネットワークをグラフィカルに確認！】&#xa;UTMの効果が分かりやすいセキュリティレポートを毎月メールでお届けします&#xa;もちろん、専用の設定画面から随時確認することも可能です&#xa;目に見えない会社を取り巻く通信環境を確認するお役に立ちます&#xa;" style="text;align=left;verticalAlign=top;rounded=1;fontFamily=consolas;fontSize=10;absoluteArcSize=0;autosize=1;container=0;collapsible=0;resizeWidth=0;resizeHeight=0;spacing=1;sketch=1;fillColor=#cce5ff;glass=0;opacity=70;strokeColor=#FF3333;arcSize=10;labelBackgroundColor=none;comic=0;fontColor=#000000;html=0;disableMultiStroke=1;hachureGap=-1;fillWeight=-1;fontStyle=0" parent="taJ2-aKvOxlszer66Cwq-5" vertex="1">
          <mxGeometry x="103.94" width="370" height="60" as="geometry" />
        </mxCell>
