                <dt>モリタ お客様相談センター</dt>
                <dd>フリーコール：<a class="p-topNewAffected__link" href="tel:0800-222-8020" id="home_affectde_tel">0800-222-8020</a></dd>
              </dl>
            </div>
          </div>
        </div>
