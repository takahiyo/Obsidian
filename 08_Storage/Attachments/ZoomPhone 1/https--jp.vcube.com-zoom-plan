    el.dispatchEvent(new Event('change', { bubbles:true }));
  } catch(e){
    try { el.value = value; } catch(_) {}
  }
}

const EXPIRY_TIME = 30 * 24 * 60 * 60 * 1000;

function getStorage(key){
  let itemStr;
  try { itemStr = sessionStorage.getItem(key); } catch(e){ return null; }
